# Copy to .env.local and fill in your values.
# Never commit .env or .env.local to git.
#
# EmailJS setup: see emailjs-template.html for the email HTML template
# and the full list of template variables (latitude, longitude, etc.)

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Public URL of the deployed site (no trailing slash). Enables canonical + Open Graph absolute URLs
# and the website line on the resume. Leave unset until the site is deployed.
# VITE_SITE_URL=https://your-domain.com
