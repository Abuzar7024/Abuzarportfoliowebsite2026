# Copy to .env.local and fill in your values.
# Never commit .env or .env.local to git.

# EmailJS Configuration (AI Hackathon Lead Notifications & Contact Forms)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# PayU Custom Checkout Configuration (Server-only secrets — NEVER prefix with VITE_ or NEXT_PUBLIC_)
PAYU_ENVIRONMENT=production
PAYU_MODE=live
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_CLIENT_ID=
PAYU_CLIENT_SECRET=
PAYU_REGISTRATION_FEE_INR=499
AVATAR_SIGNING_SECRET=

# Supabase Configuration (Server-only AI Hackathon Registration Storage)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional Backup Notification Channels (used automatically if primary EmailJS fails)
BACKUP_EMAILJS_SERVICE_ID=
BACKUP_EMAILJS_TEMPLATE_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BACKUP_NOTIFICATION_WEBHOOK_URL=

# Public URL of the deployed site (no trailing slash)
# VITE_SITE_URL=https://abuzarcode.in
